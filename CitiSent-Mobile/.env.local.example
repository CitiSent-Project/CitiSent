# ─────────────────────────────────────────────────────────────────────────────
# SECURITY NOTE — EXPO_PUBLIC_ variables are compiled into the JS bundle and
# are visible to anyone who decompiles the APK or inspects the Expo bundle.
# These are NOT secret. Never store private server keys here.
#
# EXPO_PUBLIC_SUPABASE_KEY should be your Supabase "anon" (publishable) key.
# It is safe to expose ONLY IF Row Level Security (RLS) is strictly enforced
# on EVERY table in your Supabase project. Verify this before going to production.
#
# To audit your RLS policies:
#   https://supabase.com/docs/guides/database/postgres/row-level-security
# ─────────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Cloudflare Turnstile site key (public — safe to expose in mobile bundle)
# Get this from: https://dash.cloudflare.com → Turnstile → your site → Site Key
EXPO_PUBLIC_TURNSTILE_SITE_KEY=