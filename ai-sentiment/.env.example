# ─────────────────────────────────────────────────────────────────
# CitiSent AI-Sentiment Service — Environment Configuration
# Copy this file to .env and fill in your values.
# In Docker, these are injected by docker-compose.yml instead.
# ─────────────────────────────────────────────────────────────────

# ── Gemini API ───────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ── CORS / Allowed Origins ───────────────────────────────────────
# Comma-separated list of frontend URLs allowed to call this API.
# If not set, defaults to * (allow all) — only safe for local dev.
# Local dev:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Production (update after Vercel deploys):
# ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Rate Limiter — Gemini Quota Control ──────────────────────────
# Controls how many requests are sent to Gemini per minute.
# Tune these when upgrading tiers — no code changes needed.
#
# Free tier  (~30 RPM):
GEMINI_RPM_LIMIT=25
GEMINI_MAX_CONCURRENT=3
#
# Paid tier (~4,000 RPM) — uncomment and replace above when upgrading:
# GEMINI_RPM_LIMIT=2000
# GEMINI_MAX_CONCURRENT=50