# ==============================================================================
# CitiSent-Ops Backend Environment Template
# ==============================================================================

PORT=5001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5174

# ------------------------------------------------------------------------------
# Active: Supabase Project (PostgreSQL + Auth)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-active-project.supabase.co
SUPABASE_ANON_KEY=ey...your_active_anon_key...
SUPABASE_SERVICE_ROLE_KEY=ey...your_active_service_role_key...

# ------------------------------------------------------------------------------
# Inactive / Future (Phase 3): Target Database Project
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://your-future-project.supabase.co
# SUPABASE_ANON_KEY=ey...your_future_anon_key...
# SUPABASE_SERVICE_ROLE_KEY=ey...your_future_service_role_key...


# Developer Authorization (Strict Comma-Separated Whitelist)
DEVELOPER_ALLOWED_EMAILS=lead-dev@citisent.dev,ops-admin@citisent.dev

# Client Web Portal Base URL (Used to generate Superadmin password setup links)
CLIENT_WEB_APP_BASE_URL=https://citisent-website.vercel.app
# CLIENT_WEB_APP_BASE_URL=http://localhost:5173

# Email Delivery Provider: Brevo (Recommended - HTTPS Port 443)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your_verified_sender@gmail.com
BREVO_SENDER_NAME=CitiSent Platform

# Secondary Email Provider: Gmail SMTP / Nodemailer (Optional fallback)
GMAIL_USER=
GMAIL_APP_PASSWORD=
