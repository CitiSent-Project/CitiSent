# CitiSent Website - Environment Configuration Template
# Copy this file to .env.local for local development or set in your production hosting platform

# Base API URL for CitiSent Express Backend (Must use HTTPS in production)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Request timeout in milliseconds (optional, default: 15000)
VITE_API_TIMEOUT_MS=15000
