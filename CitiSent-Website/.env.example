# CitiSent Website - Environment Configuration Template
# Copy this file to .env.local for local development.
# For production, set all VITE_* variables in Vercel Project Settings (NOT in tracked files).

# Base API URL for CitiSent Express Backend (Must use HTTPS in production)
# Example: https://citisent-backend.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Request timeout in milliseconds (optional, default: 15000)
VITE_API_TIMEOUT_MS=15000

# Login performance debug logging — OMIT or set to false in production
# VITE_LOGIN_PERF_DEBUG=false

# IMPORTANT: After setting VITE_API_BASE_URL for production, update the
# Content-Security-Policy in vercel.json to replace the placeholder:
#   YOUR-RENDER-APP.onrender.com  →  <your-actual-render-hostname>
# Never store Supabase service-role keys, JWT secrets, or passwords in VITE_* variables.
